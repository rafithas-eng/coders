{
  "name": "@novo-projeto",
  "private": true,
  "scripts": {
    "predev": "kill-port 3000 3005",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ]
}